# Backend Server Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (Required)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional OpenAI model overrides
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional Gemini provider (used for balancing/failover with OpenAI)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# AI provider strategy
# balanced (default): rotate requests across configured providers to use both free quotas
# openai_primary: OpenAI first, Gemini fallback
# gemini_primary: Gemini first, OpenAI fallback
AI_PROVIDER_MODE=balanced

# Cooldown duration (ms) when a provider hits quota/auth/upstream failures before retrying it
AI_PROVIDER_COOLDOWN_MS=600000

# Server Configuration
PORT=3001
NODE_ENV=development

# Logging Configuration
# Set LOG_FILES=true to enable file logging in development
# LOG_LEVEL=debug|info|warn|error (default: debug for dev, info for prod)
LOG_LEVEL=debug
LOG_FILES=false

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window per IP (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Supabase Configuration (Required)
# Get these from your Supabase project: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google OAuth (for Calendar Integration) (Optional)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/callback/google

# Microsoft OAuth (for Outlook Integration) (Optional)
# Get these from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/calendar/callback/outlook

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Stripe Configuration (Optional, for payment processing)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
