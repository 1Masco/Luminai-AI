# Frontend Environment Variables
# Copy this file to .env.local and fill in your values
# All VITE_ prefixed variables are exposed to the browser

# Backend API URL
# Development: http://localhost:3001
# Production: https://your-backend-domain.com
VITE_API_URL=http://localhost:3001

# Supabase Configuration (Required)
# Get these from your Supabase project: https://app.supabase.com/project/_/settings/api
# Used for authentication and database access
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google APIs Configuration (Optional)
# Get from: https://console.cloud.google.com/
# Used for Google Calendar sync and Drive file imports
VITE_GOOGLE_API_KEY=your_google_api_key
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Dropbox Configuration (Optional)
# Get from: https://www.dropbox.com/developers/apps
# Used for Dropbox file imports
VITE_DROPBOX_APP_KEY=your_dropbox_app_key

# Development/Testing
# Set to true to enable mock authentication when Supabase is not configured
VITE_ENABLE_MOCK_AUTH=false

# Feature Gating
# Set to true to disable all feature restrictions (make all features free for all users)
VITE_DISABLE_FEATURE_GATING=true
